# Copy to .env and fill in what you have. Everything is optional except DISCORD_TOKEN for the bot.

# --- Discord (required for the bot) ---
DISCORD_TOKEN=
DISCORD_GUILD_ID=            # your server id: slash commands appear instantly instead of after up to an hour

# --- LLMs: Grok writes intros/nudges/speaker blurbs; Claude extracts facts and judges matches ---
# Either one alone works (it covers the other's role); with neither, deterministic templates are used and labelled.
XAI_API_KEY=
XAI_MODEL=grok-4.7
ANTHROPIC_API_KEY=
# KYM_CLAUDE_MODEL=claude-opus-5-5
# KYM_CLAUDE_EXTRACT_EFFORT=low
# KYM_CLAUDE_JUDGE_EFFORT=medium

# --- Database: SQLite by default (data/kym.db). For Supabase use the Session pooler URI ---
# DATABASE_URL=postgresql://postgres.<project>:<password>@aws-0-eu-west-2.pooler.supabase.com:5432/postgres

# --- Notion lead view: create an integration, share one page with it, paste the page id ---
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=

# --- Public data ---
GITHUB_TOKEN=                # a fine-grained token with no scopes; 5,000 requests/hour instead of 60

# --- Schedule (local time, Monday=0) and behaviour ---
# KYM_TIMEZONE=Europe/London
# KYM_PROPOSE_WEEKDAY=0
# KYM_PROPOSE_HOUR=9
# KYM_SEND_WEEKDAY=1
# KYM_SEND_HOUR=9
# KYM_DIGEST_WEEKDAY=4
# KYM_DIGEST_HOUR=17
# KYM_RESPONSE_TTL_HOURS=72
# KYM_FOLLOWUP_AFTER_HOURS=96
# KYM_REVIVE_AUTOPOST=0      # 1 = post nudges without the lead clicking "Post it" (max 3/day, 1 per channel)
# KYM_REVIVE_DEAD_AFTER_HOURS=72
# KYM_LLM_RERANK=1
# KYM_INCLUDE_SYNTHETIC=0    # 1 only on a demo server: match the synthetic members too (nothing is ever sent to them)
# KYM_AUTOPILOT=1            # 0 = nothing runs on the schedule; steps run only via /kym run (demos, rehearsals)
